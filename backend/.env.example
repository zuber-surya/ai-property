# Copy to backend/.env — NEVER commit the real one.
# All settings load through app/core/config.py. Secrets come from env vars only.

# --- Database (Supabase Postgres, via SQLAlchemy) -------------------------
# asyncpg driver. The Supabase client is used ONLY for Auth and Storage
# (ADR-0005) — never for data access.
# Migrations + admin tooling — superuser, BYPASSES RLS. Never on a request path.
SUPABASE_POSTGRES_URL=postgresql+asyncpg://postgres:password@localhost:5432/propvista
# The request path — non-superuser role, RLS APPLIES. Every tenant query uses this.
APP_DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/propvista

# --- Supabase (Auth + Storage only) --------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
# DANGER: bypasses RLS. Migrations and admin tooling ONLY. Must never reach
# the frontend, and never a request path serving a tenant user.
SUPABASE_SERVICE_KEY=replace-me

# --- AWS Bedrock ----------------------------------------------------------
# ⚠️ AWS_REGION is BLOCKED on gap I1: Bedrock Claude availability vs. an
# India-first product. See docs/GAPS.md.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
BEDROCK_MODEL_ID=replace-me
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- App ------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
